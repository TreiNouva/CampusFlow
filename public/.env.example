# === Supabase ===
# Ambil dari Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key HANYA dipakai di server (server actions), JANGAN pernah expose ke client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Email ===
# Email notifikasi aplikasi. CampusFlow memakai Gmail tim lewat SMTP (tanpa domain sendiri):
#   aktifkan 2-Step Verification di akun Gmail, lalu buat App Password (16 huruf).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=campusflow.tim@gmail.com
SMTP_PASS="abcd efgh ijkl mnop"
EMAIL_FROM="CampusFlow <campusflow.tim@gmail.com>"
# Alternatif (butuh domain terverifikasi di Resend). Kosongkan jika memakai SMTP di atas.
RESEND_API_KEY=

# Base URL untuk membuat link di dalam email (link ke task/project).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Tim CampusFlow ===
# Email anggota tim yang boleh membuka rekap interest check di /admin/interest (pisahkan dengan koma).
ADMIN_EMAILS="email1@binus.ac.id,email2@gmail.com"
