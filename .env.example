# === Supabase ===
# Ambil dari Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key HANYA dipakai di server (server actions), JANGAN pernah expose ke client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Email (Resend) ===
# Daftar gratis di https://resend.com, verifikasi domain/pengirim.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM="CampusFlow <notifications@yourdomain.com>"

# Base URL untuk membuat link di dalam email (link ke task/project).
NEXT_PUBLIC_APP_URL=http://localhost:3000
